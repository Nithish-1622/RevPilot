# Database Configuration
POSTGRES_DB=revpilot
POSTGRES_USER=revpilot_user
POSTGRES_PASSWORD=revpilot_pass
POSTGRES_PORT=5433
DATABASE_URL=jdbc:postgresql://localhost:5433/revpilot

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Spring Boot Control Plane
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=revpilot_super_secret_jwt_key_32_bytes_min_length!!

# AI Microservice (FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=revpilot_ai_service_secret_token_12345

# LLM Configurations
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Razorpay Integration (Test Mode)
RAZORPAY_KEY_ID=rzp_test_dummy_key_id
RAZORPAY_KEY_SECRET=rzp_test_dummy_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret
